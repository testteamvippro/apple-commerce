# Apple Store VN — Backend Configuration
# Copy this file to .env and fill in your settings

# ══════════════════════════════════════════════════════════════════════════════
# SERVER CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════════

# Server port
PORT=3000

# Environment (development, staging, production)
NODE_ENV=development

# API prefix
API_PREFIX=/api

# CORS configuration (comma-separated origins)
CORS_ORIGIN=*

# ══════════════════════════════════════════════════════════════════════════════
# DATABASE CONFIGURATION  (MySQL via phpMyAdmin)
# ══════════════════════════════════════════════════════════════════════════════
#
# HOW TO CONNECT phpMyAdmin:
#  1. Open phpMyAdmin (usually http://localhost/phpmyadmin)
#  2. Click "Import" → choose schema.sql → click Go
#  3. Fill in the credentials below (they match your phpMyAdmin login)
#  4. Set these as environment variables OR edit DB_USER/DB_PASS in api/config.php
#
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=apple_store_prod

# ══════════════════════════════════════════════════════════════════════════════
# EMAIL CONFIGURATION (SMTP)
# ══════════════════════════════════════════════════════════════════════════════

# SMTP Server
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# SMTP Credentials
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email sender address
SMTP_FROM=noreply@applestore.vn

# Receiver for admin notifications
ADMIN_EMAIL=admin@applestore.vn

# ══════════════════════════════════════════════════════════════════════════════
# PAYMENT GATEWAY CONFIGURATION
# Not used — this store is cash-on-delivery (COD) only.
# ══════════════════════════════════════════════════════════════════════════════
# STORAGE CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════════

# Local storage
STORAGE_TYPE=local
STORAGE_PATH=./data

# AWS S3 (optional)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
AWS_S3_BUCKET=apple-store-vn

# ══════════════════════════════════════════════════════════════════════════════
# LOGGING CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════════

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Log file path
LOG_PATH=./logs

# ══════════════════════════════════════════════════════════════════════════════
# API KEYS & SECURITY
# ══════════════════════════════════════════════════════════════════════════════

# API Key for admin endpoints
API_KEY=your-secret-api-key-here

# JWT Secret (for future authentication)
JWT_SECRET=your-jwt-secret-key-here

# Rate limiting
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100

# ══════════════════════════════════════════════════════════════════════════════
# ANALYTICS & TRACKING
# ══════════════════════════════════════════════════════════════════════════════

# Google Analytics ID
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Sentry (error tracking) - optional
SENTRY_DSN=

# ══════════════════════════════════════════════════════════════════════════════
# MOBILE APP CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════════

# Push notification service
PUSH_NOTIFICATION_KEY=

# ══════════════════════════════════════════════════════════════════════════════
# FEATURES
# ══════════════════════════════════════════════════════════════════════════════

# Enable/disable features
ENABLE_REVIEWS=true
ENABLE_WISHLIST=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_ADMIN_DASHBOARD=true
